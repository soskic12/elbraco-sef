# Podesavanja panela NA SERVERU.
# Ovaj fajl ostaje na serveru izmedju verzija - postavi.ps1 ga ne dira.
# Popuni dva reda oznacena sa <<< pa pokreni servis.

# ------- SEF -------
SEF_ENV=prod
# <<< API kljuc sa eFaktura portala (Podesavanja -> API management)
SEF_API_KEY=
COMPANY_VAT=104220952
COMPANY_REG_NO=
COMPANY_NAME=ELBRACO GROUP DOO

# ------- Baza panela -------
# SQLite u data\ je dovoljan: jedan operater, nekoliko hiljada dokumenata godisnje.
# Za MS SQL: DB_URL=mssql+pyodbc://nalog:lozinka@SERVER/SefSync?driver=ODBC+Driver+18+for+SQL+Server

# ------- ERP baza i sifarnik -------
# Kredencijali se NE prepisuju ovde - citaju se iz web.config-a sajta logistike,
# gde vec stoje. Proveri putanju ako je sajt drugde.
ERP_SECRETS_FILE=C:\inetpub\logistika\web.config
ERP_SECRETS_KEY=ConnectionStrings__ErpDatabase
BU_SOURCE_SQL=SELECT 'MP' + RTRIM(p.SIFRA)                            AS code, RTRIM(p.NAZIV)                                   AS name, 'maloprodaja'                                    AS kind, RTRIM(p.SIFRA)                                   AS erp_code, RTRIM(p.ADRESA)                                  AS address, RTRIM(k.Region)                                  AS city, RTRIM(k.PTTBroj)                                 AS postal_code, NULLIF(CONCAT_WS(',', k.EmailProdavnice, k.EmailPoslovodje, o.Emails), '')   AS emails, NULLIF(CONCAT_WS(',', k.TelefonProdavnice, k.TelefonFiksni, o.Telefoni), '') AS phones, ISNULL(k.Aktivan, 1)                             AS active, CASE WHEN RTRIM(p.ROBNO) = 'Ne' OR p.NAZIV LIKE '%USLUG%' THEN 0 ELSE 1 END AS routable FROM dbo.PRODAV p LEFT JOIN dbo.PRODAV_KONTAKT k ON RTRIM(k.SIFRAPRO) = RTRIM(p.SIFRA) LEFT JOIN ( SELECT RTRIM(SifraPovezanogObjekta) AS Sifra, STRING_AGG(NULLIF(RTRIM(Email), 'nepoznato'), ',')          AS Emails, STRING_AGG(NULLIF(RTRIM(MobilniTelefon), 'nepoznato'), ',') AS Telefoni FROM dbo.kontakti_osobe WHERE Aktivan = 1 AND SifraPovezanogObjekta IS NOT NULL AND RTRIM(SifraPovezanogObjekta) <> '' AND RTRIM(Funkcija) IN ('POSLOVODJA', 'ZAMENIK POSLOVODJE') GROUP BY RTRIM(SifraPovezanogObjekta) ) o ON o.Sifra = RTRIM(p.SIFRA) UNION ALL SELECT 'MAG' + RTRIM(m.SIFRA), RTRIM(m.NAZIV), 'magacin', RTRIM(m.SIFRA), RTRIM(k.Adresa), RTRIM(k.Mesto), RTRIM(k.PTT), RTRIM(k.EmailOpsti), NULLIF(CONCAT_WS(',', k.TelefonOpsti, k.TelefonFiksni), ''), ISNULL(k.Aktivan, 1), CASE WHEN RTRIM(m.SIFRA) IN ('005', '010') THEN 0 WHEN k.Adresa IS NULL OR RTRIM(k.Adresa) = '' THEN 0 ELSE 1 END FROM dbo.MAGACINI m LEFT JOIN dbo.MAGACIN_KONTAKT k ON RTRIM(k.SIFRAMAG) = RTRIM(m.SIFRA) UNION ALL SELECT 'OFFICE', 'UPRAVA — FINANSIJE', 'uprava', NULL, NULL, NULL, NULL, STRING_AGG(RTRIM(o.Email), ','), STRING_AGG(RTRIM(o.MobilniTelefon), ','), 1, 1 FROM dbo.kontakti_osobe o WHERE o.Aktivan = 1 AND RTRIM(o.Funkcija) = 'FINANSIJE'

# ------- Sinhronizacija -------
POLL_INTERVAL_MINUTES=15
SYNC_OVERLAP_DAYS=3

# ------- Prihvatanje na SEF-u -------
AUTO_ACCEPT=off

# ------- Pristup -------
# Operateri: prijave iz KONTAKTI_OSOBE. Poslovodje se ne upisuju - njih
# prepoznaje objekat u sifarniku.
WEB_OPERATORS=NinaR,DusanSelak
# Rezervna prijava za slucaj da SQL server nije dostupan.
WEB_USERS=admin:promeni-me
# WEB_SECRET generise postavi.ps1 pri prvoj instalaciji.
WEB_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ------- Email -------
NOTIFY_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=elbracogroup@gmail.com
# <<< app password naloga elbracogroup@gmail.com (16 slova; razmaci mogu da ostanu)
SMTP_PASSWORD=
SMTP_FROM=elbracogroup@gmail.com
SMTP_FROM_NAME=ELBRACO e-fakture
SMTP_STARTTLS=true
NOTIFY_BCC=

# PROBNI REZIM: dok je ovde adresa, obavestenja NE idu objektima nego samo njoj.
# Isprazniti kad se pusti u redovan rad.
NOTIFY_OVERRIDE_TO=bane12@elbraco.rs

# Adresa panela kako je vide korisnici (ide u mejlove).
PUBLIC_BASE_URL=http://SERVER:8080

LOG_LEVEL=INFO
