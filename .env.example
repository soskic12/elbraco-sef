# ------- SEF -------
# demo | prod
SEF_ENV=demo
# API kljuc iz eFaktura portala: Podesavanja -> API management
SEF_API_KEY=
# PIB nase firme
COMPANY_VAT=
# matični broj firme
COMPANY_REG_NO=
COMPANY_NAME=ELBRACO DOO

# ------- Baza aplikacije -------
# Dev (podrazumevano): SQLite u data/sefsync.db
# DB_URL=mssql+pyodbc://sef_user:lozinka@SQLSERVER/SefSync?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ------- ERP baza (faza 2) -------
# ERP_DB_URL=mssql+pyodbc://erp_user:lozinka@SQLSERVER/ERPBaza?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ------- Šifarnik poslovnih jedinica iz postojeće tabele na serveru -------
# Ako je prazno, koristi se ERP_DB_URL. Upit mora da vrati bar kolone code i name.
# BU_SOURCE_DB_URL=mssql+pyodbc://user:lozinka@SQLSERVER/BAZA?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# BU_SOURCE_SQL=SELECT sifra AS code, naziv AS name, tip AS kind, sifra AS erp_code, adresa AS address, mesto AS city, email AS emails, telefon AS phones FROM dbo.PoslovneJedinice WHERE aktivna = 1

# ------- Sinhronizacija -------
POLL_INTERVAL_MINUTES=15
SYNC_OVERLAP_DAYS=3
# SYNC_START_DATE=2026-01-01

# ------- Prihvatanje na SEF-u -------
# off | routed | all
AUTO_ACCEPT=off
AUTO_ACCEPT_DELAY_HOURS=0
# AUTO_ACCEPT_MAX_AMOUNT=200000

# ------- Email -------
NOTIFY_EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=efakture@elbraco.rs
SMTP_STARTTLS=true
NOTIFY_BCC=

# ------- Push (Viber/WhatsApp/SMS gateway) -------
PUSH_ENABLED=false
PUSH_WEBHOOK_URL=
PUSH_AUTH_HEADER=

PUBLIC_BASE_URL=http://sef.elbraco.local:8080

# ------- Web -------
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_USERS=admin:promeni-me
LOG_LEVEL=INFO
